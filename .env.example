# FILE: .env.example
# eLogix HRMS — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub
# eLogix Technologies · www.elogix.com.np

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=production
FLASK_ENV=production
PORT=8080
SECRET_KEY=change-this-to-a-random-32-char-string-in-production

# ── Database (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@elogix_db:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=postgres

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://elogix_redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-32-chars-min
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# ── eLogix SaaS Admin ─────────────────────────────────────────────────
ELOGIX_ADMIN_KEY=elogix-admin-2026

# ── AI ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6

# ── Email (SMTP) ──────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SENDER=noreply@elogix.com.np

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://elogix.com.np

# ── Vite dev proxy (development only) ────────────────────────────────
VITE_API_HOST=127.0.0.1
VITE_API_PORT=8080
