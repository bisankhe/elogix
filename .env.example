# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://elogix:elogix@localhost:5432/elogix

# ── Auth ───────────────────────────────────────────────────────────────
# One secret. pydantic-settings fails at boot if it is missing or short.
SECRET_KEY=change-me-to-at-least-32-characters-of-random
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ── App ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
