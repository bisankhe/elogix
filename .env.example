# FILE: .env.example
# NepHR Pro — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to version control

# ── Flask ──────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=your-super-secret-key-change-in-production-32chars

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://nephr_user:nephr_password@localhost:5432/nephr_pro
# Production:
# DATABASE_URL=postgresql://nephr_user:STRONG_PASS@db.yourdomain.com:5432/nephr_pro

# ── Redis (for production caching) ────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Services ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
# Browser-accessible copy (Vite only exposes VITE_* to browser)
VITE_ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voice Input (optional)
OPENAI_API_KEY=sk-your-openai-key-for-whisper-transcription

# ── Multi-tenancy ──────────────────────────────────────────
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
TENANT_MODE=header        # header | subdomain | jwt

# ── Nepal Defaults (Labour Act 2074) ───────────────────────
NEPAL_MIN_WAGE_NPR=15000
NEPAL_MAX_PROBATION_MONTHS=6
NEPAL_MAX_CASUAL_DAYS_MONTH=7
NEPAL_PF_EMPLOYER_PCT=10.0
NEPAL_SSF_EMPLOYER_PCT=3.33
NEPAL_TDS_SERVICES_PCT=1.5

# ── File Storage ───────────────────────────────────────────
# For Excel templates and document uploads
STORAGE_BACKEND=local           # local | s3 | azure
LOCAL_UPLOAD_DIR=./uploads
# S3 (if using AWS):
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_BUCKET_NAME=nephrpro-uploads
# S3_REGION=ap-south-1

# ── Email (for alerts) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@nephrpro.com
SMTP_PASS=your-smtp-password
FROM_EMAIL=NepHR Pro <noreply@nephrpro.com>

# ── SAP / ERP Integration (optional) ──────────────────────
SAP_API_URL=https://your-sap-instance.com/api
SAP_CLIENT_ID=your-sap-client-id
SAP_CLIENT_SECRET=your-sap-secret

# ── Rate Limiting ──────────────────────────────────────────
RATELIMIT_DEFAULT=500 per hour
RATELIMIT_AI_ENDPOINTS=20 per hour

# ── Security ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://app.nephrpro.com
JWT_EXPIRY_HOURS=8
REFRESH_TOKEN_DAYS=30
