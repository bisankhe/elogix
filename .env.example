# ── Database ───────────────────────────────────────────────────────────
# Two connections, deliberately.
#
# DATABASE_URL is what the application runs as. It MUST be a NOSUPERUSER,
# NOBYPASSRLS role or row-level security is silently skipped — Postgres exempts
# superusers from policies even on a FORCE ROW LEVEL SECURITY table, so the
# isolation would look enabled and enforce nothing.
#
# DATABASE_ADMIN_URL owns the schema and is used only by Alembic. The migration
# creates the runtime role and grants it DML.
DATABASE_URL=postgresql+psycopg://elogix_app:elogix_app@localhost:5432/elogix
DATABASE_ADMIN_URL=postgresql+psycopg://elogix:elogix@localhost:5432/elogix

APP_DB_ROLE=elogix_app
# Change this in production. It is the runtime database password.
APP_DB_PASSWORD=elogix_app

# ── Auth ───────────────────────────────────────────────────────────────
# One secret. pydantic-settings fails at boot if it is missing or short.
SECRET_KEY=change-me-to-at-least-32-characters-of-random
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ── App ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
