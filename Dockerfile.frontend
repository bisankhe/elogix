# FILE: Dockerfile.frontend
# eLogix HRMS — Frontend Docker Image
# Stage 1: Node.js → npm install → vite build
# Stage 2: nginx serves the static React SPA
# FIX: uses npm install (not npm ci) so stale package-lock.json doesn't block the build
# eLogix Technologies · www.elogix.com.np

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package.json only (NOT package-lock.json — avoids npm ci lockfile conflicts)
COPY package.json ./

# Use npm install (not npm ci) — works even when package-lock.json is missing or stale
# --legacy-peer-deps allows broader peer dependency resolution
RUN npm install --legacy-peer-deps

# Copy all source files
COPY . .

# Build the React/Vite app
RUN npm run build

# Verify dist was created
RUN test -d dist && test -f dist/index.html \
    || (echo "BUILD FAILED: dist/index.html missing" && exit 1)

# Show what was built
RUN echo "Build successful:" && ls -la dist/ && ls dist/assets/ | head -5

# ── Stage 2: nginx serves the built SPA ──────────────────────────────
FROM nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# Copy built files from builder
COPY --from=builder /app/dist .

# Inline nginx config (no external nginx.conf dependency)
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript;\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        try_files $uri =404;\n\
    }\n\
    location /api/ {\n\
        resolver 127.0.0.11 valid=30s;\n\
        set $backend "elogix_backend:5000";\n\
        proxy_pass http://$backend;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_connect_timeout 5s;\n\
        proxy_read_timeout 60s;\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
        add_header Cache-Control "no-cache";\n\
    }\n\
    location = /favicon.ico { return 204; access_log off; }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ > /dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
