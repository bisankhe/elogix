{
  "components": {
    "schemas": {
      "AccessToken": {
        "description": "Only the access token crosses in the body.\n\nThe refresh token goes back as an httpOnly cookie so no script on the page can read\nit \u2014 including a script injected into the page.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "AccessToken",
        "type": "object"
      },
      "EmployeeList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EmployeeOut"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "EmployeeList",
        "type": "object"
      },
      "EmployeeOut": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "employee_code": {
            "title": "Employee Code",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "joined_on": {
            "format": "date",
            "title": "Joined On",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EmployeeStatus"
          }
        },
        "required": [
          "id",
          "employee_code",
          "full_name",
          "email",
          "status",
          "joined_on"
        ],
        "title": "EmployeeOut",
        "type": "object"
      },
      "EmployeeStatus": {
        "enum": [
          "active",
          "probation",
          "suspended",
          "exited"
        ],
        "title": "EmployeeStatus",
        "type": "string"
      },
      "EntitlementsOut": {
        "description": "What the frontend may use to decide what to show. Never what the server uses to\ndecide what to allow \u2014 that is `require_module`, on the router.",
        "properties": {
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleCode"
            },
            "title": "Modules",
            "type": "array"
          },
          "plan_tier": {
            "$ref": "#/components/schemas/PlanTier"
          }
        },
        "required": [
          "company_id",
          "plan_tier",
          "modules"
        ],
        "title": "EntitlementsOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "company_slug": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Company Slug",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "company_slug"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ModuleCode": {
        "enum": [
          "org",
          "employee",
          "attendance",
          "leave",
          "payroll",
          "ess",
          "reports",
          "ats",
          "performance",
          "training",
          "vendor",
          "compliance",
          "finance",
          "ai"
        ],
        "title": "ModuleCode",
        "type": "string"
      },
      "PlanTier": {
        "description": "The five-tier plan ladder. Also the build order \u2014 each tier is roughly a phase.",
        "enum": [
          "trial",
          "starter",
          "growth",
          "business",
          "enterprise"
        ],
        "title": "PlanTier",
        "type": "string"
      },
      "RoleCode": {
        "enum": [
          "super_admin",
          "hr_manager",
          "hr_officer",
          "manager",
          "employee"
        ],
        "title": "RoleCode",
        "type": "string"
      },
      "UserOut": {
        "properties": {
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleCode"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "company_id",
          "email",
          "full_name",
          "roles"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "eLogix HRMS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "meta-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Meta-Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/auth/entitlements": {
      "get": {
        "operationId": "auth-entitlements",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Entitlements",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth-login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth-logout",
        "parameters": [
          {
            "in": "cookie",
            "name": "elogix_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Elogix Refresh"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "auth-refresh",
        "parameters": [
          {
            "in": "cookie",
            "name": "elogix_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Elogix Refresh"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/employees": {
      "get": {
        "operationId": "employees-list_employees",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Employees",
        "tags": [
          "employees"
        ]
      }
    },
    "/api/v1/employees/{employee_id}": {
      "get": {
        "operationId": "employees-get_employee",
        "parameters": [
          {
            "in": "path",
            "name": "employee_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Employee Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Employee",
        "tags": [
          "employees"
        ]
      }
    }
  }
}
